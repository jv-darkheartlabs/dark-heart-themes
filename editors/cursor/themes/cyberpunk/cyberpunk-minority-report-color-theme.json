{
  "name": "Cyberpunk - Minority Report \u2014 Precrime",
  "type": "dark",
  "colors": {
    "editor.background": "#0C1720",
    "editor.foreground": "#DCEAF0",
    "editor.lineHighlightBackground": "#223D4E",
    "editorLineNumber.foreground": "#9DB2BF",
    "editorLineNumber.activeForeground": "#9AC7E7",
    "editorGutter.background": "#0C1720",
    "sideBar.background": "#172A38",
    "foreground": "#DCEAF0",
    "descriptionForeground": "#9DB2BF",
    "list.highlightForeground": "#9AC7E7",
    "dropdown.background": "#223D4E",
    "list.hoverBackground": "#3F5C70",
    "panel.border": "#3F5C70",
    "focusBorder": "#9AC7E7",
    "editorGroupHeader.tabsBackground": "#172A38",
    "tab.activeBackground": "#223D4E",
    "tab.inactiveBackground": "#0C1720",
    "panel.background": "#172A38",
    "titleBar.activeBackground": "#172A38",
    "statusBar.background": "#172A38",
    "terminal.background": "#0C1720",
    "terminal.foreground": "#DCEAF0",
    "terminal.ansiBlack": "#101015",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#DCEAF0",
    "activityBar.background": "#172A38",
    "sideBarTitle.foreground": "#DCEAF0",
    "editorCursor.foreground": "#DCEAF0",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9AC7E7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A5DADE"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9DB2BF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#EEF5F6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#EEF5F6"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#A5DADE"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#9AC7E7"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#DCEAF0"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#DCEAF0"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#DCEAF0"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#EEF5F6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#9DB2BF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#9AC7E7"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A5DADE"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#EEF5F6"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#A5DADE"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#9AC7E7",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
