{
  "name": "Cyberpunk - TRON: Legacy \u2014 Tron",
  "type": "dark",
  "colors": {
    "editor.background": "#050B19",
    "editor.foreground": "#E8F0FF",
    "editor.lineHighlightBackground": "#7DA9FF0D",
    "editorLineNumber.foreground": "#91A1BC",
    "editorLineNumber.activeForeground": "#7DA9FF",
    "editorGutter.background": "#050B19",
    "sideBar.background": "#0C1730",
    "foreground": "#E8F0FF",
    "descriptionForeground": "#91A1BC",
    "list.highlightForeground": "#7DA9FF",
    "dropdown.background": "#0C1730",
    "list.hoverBackground": "#7DA9FF22",
    "panel.border": "#354E7D",
    "focusBorder": "#7DA9FF",
    "editorGroupHeader.tabsBackground": "#050B19",
    "tab.activeBackground": "#7DA9FF18",
    "tab.inactiveBackground": "#050B19",
    "panel.background": "#0C1730",
    "titleBar.activeBackground": "#050B19",
    "statusBar.background": "#050B19",
    "terminal.background": "#050B19",
    "terminal.foreground": "#E8F0FF",
    "terminal.ansiBlack": "#050B19",
    "terminal.ansiRed": "#F48787",
    "terminal.ansiGreen": "#8CCB8C",
    "terminal.ansiYellow": "#EACB78",
    "terminal.ansiBlue": "#8BB5EF",
    "terminal.ansiMagenta": "#CEAAED",
    "terminal.ansiCyan": "#84D6DC",
    "terminal.ansiWhite": "#E8F0FF",
    "activityBar.background": "#0C1730",
    "sideBarTitle.foreground": "#E8F0FF",
    "editorCursor.foreground": "#E8F0FF",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7DA9FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#BDD5FF"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#91A1BC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#9AC4FF"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#9AC4FF"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#9AC4FF"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E8F0FF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E8F0FF"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#E8F0FF"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#7DA9FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#91A1BC"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#7DA9FF"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BDD5FF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#BDD5FF"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7DA9FF",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
