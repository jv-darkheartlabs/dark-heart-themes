{
  "name": "Cyberpunk - Hackers (1995) \u2014 Hack the Planet",
  "type": "dark",
  "colors": {
    "editor.background": "#0B160F",
    "editor.foreground": "#DFF2D5",
    "editor.lineHighlightBackground": "#203B29",
    "editorLineNumber.foreground": "#9CAE9F",
    "editorLineNumber.activeForeground": "#B3EB7B",
    "editorGutter.background": "#0B160F",
    "sideBar.background": "#14291D",
    "foreground": "#DFF2D5",
    "descriptionForeground": "#9CAE9F",
    "list.highlightForeground": "#B3EB7B",
    "dropdown.background": "#203B29",
    "list.hoverBackground": "#3C6046",
    "panel.border": "#3C6046",
    "focusBorder": "#B3EB7B",
    "editorGroupHeader.tabsBackground": "#14291D",
    "tab.activeBackground": "#203B29",
    "tab.inactiveBackground": "#0B160F",
    "panel.background": "#14291D",
    "titleBar.activeBackground": "#14291D",
    "statusBar.background": "#14291D",
    "terminal.background": "#0B160F",
    "terminal.foreground": "#DFF2D5",
    "terminal.ansiBlack": "#101219",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#DFF2D5",
    "activityBar.background": "#14291D",
    "sideBarTitle.foreground": "#DFF2D5",
    "editorCursor.foreground": "#DFF2D5",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B3EB7B",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#80DCE0"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9CAE9F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#F0DF8A"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#F0DF8A"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#80DCE0"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#B3EB7B"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#DFF2D5"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#DFF2D5"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#DFF2D5"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F0DF8A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#9CAE9F"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#B3EB7B"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#80DCE0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#F0DF8A"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#80DCE0"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#B3EB7B",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
