{
  "name": "Cyberpunk - TRON: Legacy \u2014 The Grid",
  "type": "dark",
  "colors": {
    "editor.background": "#050B12",
    "editor.foreground": "#D8F3FF",
    "editor.lineHighlightBackground": "#39D9F50D",
    "editorLineNumber.foreground": "#90A7B8",
    "editorLineNumber.activeForeground": "#39D9F5",
    "editorGutter.background": "#050B12",
    "sideBar.background": "#0B1723",
    "foreground": "#D8F3FF",
    "descriptionForeground": "#90A7B8",
    "list.highlightForeground": "#39D9F5",
    "dropdown.background": "#0B1723",
    "list.hoverBackground": "#39D9F522",
    "panel.border": "#345366",
    "focusBorder": "#39D9F5",
    "editorGroupHeader.tabsBackground": "#050B12",
    "tab.activeBackground": "#39D9F518",
    "tab.inactiveBackground": "#050B12",
    "panel.background": "#0B1723",
    "titleBar.activeBackground": "#050B12",
    "statusBar.background": "#050B12",
    "terminal.background": "#050B12",
    "terminal.foreground": "#D8F3FF",
    "terminal.ansiBlack": "#050B12",
    "terminal.ansiRed": "#F48787",
    "terminal.ansiGreen": "#8CCB8C",
    "terminal.ansiYellow": "#EACB78",
    "terminal.ansiBlue": "#8BB5EF",
    "terminal.ansiMagenta": "#CEAAED",
    "terminal.ansiCyan": "#84D6DC",
    "terminal.ansiWhite": "#D8F3FF",
    "activityBar.background": "#0B1723",
    "sideBarTitle.foreground": "#D8F3FF",
    "editorCursor.foreground": "#D8F3FF",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#39D9F5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#91E9FF"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#90A7B8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#F0FAFF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#FFC078"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FFC078"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#FFC078"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#D8F3FF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#D8F3FF"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#D8F3FF"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#39D9F5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#90A7B8"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#39D9F5"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#91E9FF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#F0FAFF"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#91E9FF"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#39D9F5",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
