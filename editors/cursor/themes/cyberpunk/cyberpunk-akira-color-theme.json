{
  "name": "Cyberpunk - AKIRA \u2014 Kaneda",
  "type": "dark",
  "colors": {
    "editor.background": "#171316",
    "editor.foreground": "#F1E5CF",
    "editor.lineHighlightBackground": "#3B222C",
    "editorLineNumber.foreground": "#B7A5AC",
    "editorLineNumber.activeForeground": "#F08B8C",
    "editorGutter.background": "#171316",
    "sideBar.background": "#291A21",
    "foreground": "#F1E5CF",
    "descriptionForeground": "#B7A5AC",
    "list.highlightForeground": "#F08B8C",
    "dropdown.background": "#3B222C",
    "list.hoverBackground": "#64343E",
    "panel.border": "#64343E",
    "focusBorder": "#F08B8C",
    "editorGroupHeader.tabsBackground": "#291A21",
    "tab.activeBackground": "#3B222C",
    "tab.inactiveBackground": "#171316",
    "panel.background": "#291A21",
    "titleBar.activeBackground": "#291A21",
    "statusBar.background": "#291A21",
    "terminal.background": "#171316",
    "terminal.foreground": "#F1E5CF",
    "terminal.ansiBlack": "#101015",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#F1E5CF",
    "activityBar.background": "#291A21",
    "sideBarTitle.foreground": "#F1E5CF",
    "editorCursor.foreground": "#F1E5CF",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F08B8C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#E6C49B"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B7A5AC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#F5DDB5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#F5DDB5"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E6C49B"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#F08B8C"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#F1E5CF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#F1E5CF"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#F1E5CF"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F5DDB5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#B7A5AC"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F08B8C"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E6C49B"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#F5DDB5"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#E6C49B"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#F08B8C",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
