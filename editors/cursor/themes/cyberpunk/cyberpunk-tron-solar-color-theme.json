{
  "name": "Cyberpunk - TRON: Legacy \u2014 CLU",
  "type": "dark",
  "colors": {
    "editor.background": "#120C04",
    "editor.foreground": "#FFF0C8",
    "editor.lineHighlightBackground": "#FFD45C0D",
    "editorLineNumber.foreground": "#B0A18A",
    "editorLineNumber.activeForeground": "#FFD45C",
    "editorGutter.background": "#120C04",
    "sideBar.background": "#211707",
    "foreground": "#FFF0C8",
    "descriptionForeground": "#B0A18A",
    "list.highlightForeground": "#FFD45C",
    "dropdown.background": "#211707",
    "list.hoverBackground": "#FFD45C22",
    "panel.border": "#66512A",
    "focusBorder": "#FFD45C",
    "editorGroupHeader.tabsBackground": "#120C04",
    "tab.activeBackground": "#FFD45C18",
    "tab.inactiveBackground": "#120C04",
    "panel.background": "#211707",
    "titleBar.activeBackground": "#120C04",
    "statusBar.background": "#120C04",
    "terminal.background": "#120C04",
    "terminal.foreground": "#FFF0C8",
    "terminal.ansiBlack": "#120C04",
    "terminal.ansiRed": "#F48787",
    "terminal.ansiGreen": "#8CCB8C",
    "terminal.ansiYellow": "#EACB78",
    "terminal.ansiBlue": "#8BB5EF",
    "terminal.ansiMagenta": "#CEAAED",
    "terminal.ansiCyan": "#84D6DC",
    "terminal.ansiWhite": "#FFF0C8",
    "activityBar.background": "#211707",
    "sideBarTitle.foreground": "#FFF0C8",
    "editorCursor.foreground": "#FFF0C8",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FFD45C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#FFA950"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B0A18A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#FFF5D6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#F6C879"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F6C879"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#F6C879"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#FFF0C8"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#FFF0C8"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#FFF0C8"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#FFD45C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#B0A18A"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#FFD45C"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFA950"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#FFF5D6"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#FFA950"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#FFD45C",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
