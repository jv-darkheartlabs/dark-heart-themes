{
  "name": "Cyberpunk - Synthwave Neon \u2014 Original Palette",
  "type": "dark",
  "colors": {
    "editor.background": "#180F32",
    "editor.foreground": "#EDE4FC",
    "editor.lineHighlightBackground": "#3B285F",
    "editorLineNumber.foreground": "#B1A4CF",
    "editorLineNumber.activeForeground": "#78DBE8",
    "editorGutter.background": "#180F32",
    "sideBar.background": "#281B48",
    "foreground": "#EDE4FC",
    "descriptionForeground": "#B1A4CF",
    "list.highlightForeground": "#78DBE8",
    "dropdown.background": "#3B285F",
    "list.hoverBackground": "#5B4182",
    "panel.border": "#5B4182",
    "focusBorder": "#78DBE8",
    "editorGroupHeader.tabsBackground": "#281B48",
    "tab.activeBackground": "#3B285F",
    "tab.inactiveBackground": "#180F32",
    "panel.background": "#281B48",
    "titleBar.activeBackground": "#281B48",
    "statusBar.background": "#281B48",
    "terminal.background": "#180F32",
    "terminal.foreground": "#EDE4FC",
    "terminal.ansiBlack": "#100A20",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#A4BCEB",
    "terminal.ansiMagenta": "#F49DDA",
    "terminal.ansiCyan": "#78DBE8",
    "terminal.ansiWhite": "#EDE4FC",
    "activityBar.background": "#281B48",
    "sideBarTitle.foreground": "#EDE4FC",
    "editorCursor.foreground": "#EDE4FC",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#78DBE8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#F49DDA"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B1A4CF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#C7B6F7"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#C7B6F7"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#78DBE8"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#78DBE8"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#EDE4FC"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#EDE4FC"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#EDE4FC"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#C7B6F7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#B1A4CF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#78DBE8"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F49DDA"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#C7B6F7"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#F49DDA"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#78DBE8",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
