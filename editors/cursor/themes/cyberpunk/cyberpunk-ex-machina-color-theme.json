{
  "name": "Cyberpunk - Ex Machina \u2014 Ava\u2019s Laboratory",
  "type": "light",
  "colors": {
    "editor.background": "#F1F3EF",
    "editor.foreground": "#2D3936",
    "editor.lineHighlightBackground": "#D8E2D9",
    "editorLineNumber.foreground": "#5A655F",
    "editorLineNumber.activeForeground": "#285542",
    "editorGutter.background": "#F1F3EF",
    "sideBar.background": "#E1E7E0",
    "foreground": "#2D3936",
    "descriptionForeground": "#5A655F",
    "list.highlightForeground": "#285542",
    "dropdown.background": "#D8E2D9",
    "list.hoverBackground": "#B3BDB5",
    "panel.border": "#B3BDB5",
    "focusBorder": "#285542",
    "editorGroupHeader.tabsBackground": "#E1E7E0",
    "tab.activeBackground": "#D8E2D9",
    "tab.inactiveBackground": "#F1F3EF",
    "panel.background": "#E1E7E0",
    "titleBar.activeBackground": "#E1E7E0",
    "statusBar.background": "#E1E7E0",
    "terminal.background": "#F1F3EF",
    "terminal.foreground": "#2D3936",
    "terminal.ansiBlack": "#2D3936",
    "terminal.ansiRed": "#993E3E",
    "terminal.ansiGreen": "#285542",
    "terminal.ansiYellow": "#775A22",
    "terminal.ansiBlue": "#345B7B",
    "terminal.ansiMagenta": "#744A70",
    "terminal.ansiCyan": "#326368",
    "terminal.ansiWhite": "#5A655F",
    "activityBar.background": "#E1E7E0",
    "sideBarTitle.foreground": "#2D3936",
    "editorCursor.foreground": "#2D3936",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#285542",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#456552"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5A655F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#354D58"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#354D58"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#285542"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#285542"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#2D3936"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#2D3936"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#2D3936"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#354D58",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#5A655F"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#285542"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#456552"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#354D58"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#456552"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#285542",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
