{
  "name": "Cyberpunk - Synthwave Crimson \u2014 Original Palette",
  "type": "dark",
  "colors": {
    "editor.background": "#1D1025",
    "editor.foreground": "#F6E3EB",
    "editor.lineHighlightBackground": "#472039",
    "editorLineNumber.foreground": "#B8A1BF",
    "editorLineNumber.activeForeground": "#F37889",
    "editorGutter.background": "#1D1025",
    "sideBar.background": "#30182F",
    "foreground": "#F6E3EB",
    "descriptionForeground": "#B8A1BF",
    "list.highlightForeground": "#F37889",
    "dropdown.background": "#472039",
    "list.hoverBackground": "#78334E",
    "panel.border": "#78334E",
    "focusBorder": "#F37889",
    "editorGroupHeader.tabsBackground": "#30182F",
    "tab.activeBackground": "#472039",
    "tab.inactiveBackground": "#1D1025",
    "panel.background": "#30182F",
    "titleBar.activeBackground": "#30182F",
    "statusBar.background": "#30182F",
    "terminal.background": "#1D1025",
    "terminal.foreground": "#F6E3EB",
    "terminal.ansiBlack": "#120A18",
    "terminal.ansiRed": "#F37889",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#A4BCEB",
    "terminal.ansiMagenta": "#EBA7C7",
    "terminal.ansiCyan": "#A0D7DD",
    "terminal.ansiWhite": "#F6E3EB",
    "activityBar.background": "#30182F",
    "sideBarTitle.foreground": "#F6E3EB",
    "editorCursor.foreground": "#F6E3EB",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F37889",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#F2D1E1"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B8A1BF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#EBA7C7"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#EBA7C7"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F37889"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#F37889"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#F6E3EB"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#F6E3EB"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#F6E3EB"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#EBA7C7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#B8A1BF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F37889"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F2D1E1"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#EBA7C7"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#F2D1E1"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#F37889",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
