{
  "name": "Cyberpunk - TRON: Legacy \u2014 End of Line Club",
  "type": "dark",
  "colors": {
    "editor.background": "#101019",
    "editor.foreground": "#F4EFFA",
    "editor.lineHighlightBackground": "#EAE3FF0D",
    "editorLineNumber.foreground": "#A49DB5",
    "editorLineNumber.activeForeground": "#EAE3FF",
    "editorGutter.background": "#101019",
    "sideBar.background": "#1F1B2B",
    "foreground": "#F4EFFA",
    "descriptionForeground": "#A49DB5",
    "list.highlightForeground": "#EAE3FF",
    "dropdown.background": "#1F1B2B",
    "list.hoverBackground": "#EAE3FF22",
    "panel.border": "#574762",
    "focusBorder": "#EAE3FF",
    "editorGroupHeader.tabsBackground": "#101019",
    "tab.activeBackground": "#EAE3FF18",
    "tab.inactiveBackground": "#101019",
    "panel.background": "#1F1B2B",
    "titleBar.activeBackground": "#101019",
    "statusBar.background": "#101019",
    "terminal.background": "#101019",
    "terminal.foreground": "#F4EFFA",
    "terminal.ansiBlack": "#101019",
    "terminal.ansiRed": "#F48787",
    "terminal.ansiGreen": "#8CCB8C",
    "terminal.ansiYellow": "#EACB78",
    "terminal.ansiBlue": "#8BB5EF",
    "terminal.ansiMagenta": "#CEAAED",
    "terminal.ansiCyan": "#84D6DC",
    "terminal.ansiWhite": "#F4EFFA",
    "activityBar.background": "#1F1B2B",
    "sideBarTitle.foreground": "#F4EFFA",
    "editorCursor.foreground": "#F4EFFA",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#EAE3FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#C8A5F5"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A49DB5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#F9F5FF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#9EDDEA"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#9EDDEA"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#9EDDEA"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#F4EFFA"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#F4EFFA"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#F4EFFA"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#EAE3FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#A49DB5"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#EAE3FF"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C8A5F5"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#F9F5FF"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#C8A5F5"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#EAE3FF",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
