{
  "name": "Cyberpunk - Swordfish \u2014 Workstation",
  "type": "dark",
  "colors": {
    "editor.background": "#0C191D",
    "editor.foreground": "#DEEDEF",
    "editor.lineHighlightBackground": "#203C46",
    "editorLineNumber.foreground": "#9EB5BA",
    "editorLineNumber.activeForeground": "#83CDD0",
    "editorGutter.background": "#0C191D",
    "sideBar.background": "#142B32",
    "foreground": "#DEEDEF",
    "descriptionForeground": "#9EB5BA",
    "list.highlightForeground": "#83CDD0",
    "dropdown.background": "#203C46",
    "list.hoverBackground": "#375B65",
    "panel.border": "#375B65",
    "focusBorder": "#83CDD0",
    "editorGroupHeader.tabsBackground": "#142B32",
    "tab.activeBackground": "#203C46",
    "tab.inactiveBackground": "#0C191D",
    "panel.background": "#142B32",
    "titleBar.activeBackground": "#142B32",
    "statusBar.background": "#142B32",
    "terminal.background": "#0C191D",
    "terminal.foreground": "#DEEDEF",
    "terminal.ansiBlack": "#101015",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#DEEDEF",
    "activityBar.background": "#142B32",
    "sideBarTitle.foreground": "#DEEDEF",
    "editorCursor.foreground": "#DEEDEF",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#83CDD0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A5C6E4"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9EB5BA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#E9BE8C"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#E9BE8C"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#A5C6E4"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#83CDD0"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#DEEDEF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#DEEDEF"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#DEEDEF"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#E9BE8C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#9EB5BA"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#83CDD0"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#A5C6E4"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#E9BE8C"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#A5C6E4"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#83CDD0",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
