{
  "name": "Cyberpunk - Ghost in the Shell (2017) \u2014 Neon City",
  "type": "dark",
  "colors": {
    "editor.background": "#100D1C",
    "editor.foreground": "#E6DEEF",
    "editor.lineHighlightBackground": "#ffffff0a",
    "editorLineNumber.foreground": "#A79CB8",
    "editorLineNumber.activeForeground": "#7CDDEC",
    "editorGutter.background": "#100D1C",
    "sideBar.background": "#1B162B",
    "foreground": "#E6DEEF",
    "descriptionForeground": "#A79CB8",
    "list.highlightForeground": "#7CDDEC",
    "dropdown.background": "#1B162B",
    "list.hoverBackground": "#ffffff18",
    "panel.border": "#5C4B78",
    "focusBorder": "#7CDDEC",
    "editorGroupHeader.tabsBackground": "#100D1C",
    "tab.activeBackground": "#1B162B",
    "tab.inactiveBackground": "#100D1C",
    "panel.background": "#1B162B",
    "titleBar.activeBackground": "#100D1C",
    "statusBar.background": "#100D1C",
    "terminal.background": "#100D1C",
    "terminal.foreground": "#E6DEEF",
    "terminal.ansiBlack": "#100D1C",
    "terminal.ansiRed": "#F38D91",
    "terminal.ansiGreen": "#9BCD95",
    "terminal.ansiYellow": "#E6CD86",
    "terminal.ansiBlue": "#86B6EC",
    "terminal.ansiMagenta": "#D6A0DF",
    "terminal.ansiCyan": "#85D8D8",
    "terminal.ansiWhite": "#E6DEEF",
    "activityBar.background": "#1B162B",
    "sideBarTitle.foreground": "#E6DEEF",
    "editorCursor.foreground": "#E6DEEF",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7CDDEC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#F1A0CD"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A79CB8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#C4A6F5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#B2DFF2"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#EFA8DE"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#7CDDEC"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E6DEEF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E6DEEF"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#E6DEEF"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#7CDDEC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#A79CB8"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#7CDDEC"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E6DEEF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#7CDDEC"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#F1A0CD"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7CDDEC",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
