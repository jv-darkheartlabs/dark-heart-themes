{
  "name": "Cyberpunk - Her \u2014 Theodore & Samantha",
  "type": "dark",
  "colors": {
    "editor.background": "#25191A",
    "editor.foreground": "#F6E8D2",
    "editor.lineHighlightBackground": "#483033",
    "editorLineNumber.foreground": "#C4ABAA",
    "editorLineNumber.activeForeground": "#F39D92",
    "editorGutter.background": "#25191A",
    "sideBar.background": "#352426",
    "foreground": "#F6E8D2",
    "descriptionForeground": "#C4ABAA",
    "list.highlightForeground": "#F39D92",
    "dropdown.background": "#483033",
    "list.hoverBackground": "#6A4849",
    "panel.border": "#6A4849",
    "focusBorder": "#F39D92",
    "editorGroupHeader.tabsBackground": "#352426",
    "tab.activeBackground": "#483033",
    "tab.inactiveBackground": "#25191A",
    "panel.background": "#352426",
    "titleBar.activeBackground": "#352426",
    "statusBar.background": "#352426",
    "terminal.background": "#25191A",
    "terminal.foreground": "#F6E8D2",
    "terminal.ansiBlack": "#101015",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#F6E8D2",
    "activityBar.background": "#352426",
    "sideBarTitle.foreground": "#F6E8D2",
    "editorCursor.foreground": "#F6E8D2",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F39D92",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#E5C69E"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#C4ABAA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#F5D4AD"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#F5D4AD"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E5C69E"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#F39D92"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#F6E8D2"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#F6E8D2"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#F6E8D2"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F5D4AD",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#C4ABAA"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F39D92"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E5C69E"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#F5D4AD"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#E5C69E"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#F39D92",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
