{
  "name": "Cyberpunk - Blade Runner 2049 \u2014 Joi",
  "type": "dark",
  "colors": {
    "editor.background": "#130D21",
    "editor.foreground": "#EEE3F5",
    "editor.lineHighlightBackground": "#ffffff0a",
    "editorLineNumber.foreground": "#AB9CBF",
    "editorLineNumber.activeForeground": "#E7A0DC",
    "editorGutter.background": "#130D21",
    "sideBar.background": "#21142F",
    "foreground": "#EEE3F5",
    "descriptionForeground": "#AB9CBF",
    "list.highlightForeground": "#E7A0DC",
    "dropdown.background": "#21142F",
    "list.hoverBackground": "#ffffff18",
    "panel.border": "#695279",
    "focusBorder": "#E7A0DC",
    "editorGroupHeader.tabsBackground": "#130D21",
    "tab.activeBackground": "#21142F",
    "tab.inactiveBackground": "#130D21",
    "panel.background": "#21142F",
    "titleBar.activeBackground": "#21142F",
    "statusBar.background": "#21142F",
    "terminal.background": "#130D21",
    "terminal.foreground": "#EEE3F5",
    "terminal.ansiBlack": "#130D21",
    "terminal.ansiRed": "#F08186",
    "terminal.ansiGreen": "#99CC99",
    "terminal.ansiYellow": "#E7CD87",
    "terminal.ansiBlue": "#8DBAE8",
    "terminal.ansiMagenta": "#D8A0DE",
    "terminal.ansiCyan": "#88D1DB",
    "terminal.ansiWhite": "#EEE3F5",
    "activityBar.background": "#21142F",
    "sideBarTitle.foreground": "#EEE3F5",
    "editorCursor.foreground": "#EEE3F5",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E7A0DC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#88D5E4"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#AB9CBF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#BFA7F0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#BFA7F0"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#88D5E4"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#88D5E4"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#EEE3F5"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#EEE3F5"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#EEE3F5"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#E7A0DC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#AB9CBF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E7A0DC"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BFA7F0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#BFA7F0"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#88D5E4"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#E7A0DC",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
