{
  "name": "Cyberpunk - Avatar: Pandora \u2014 Night Bloom",
  "type": "dark",
  "colors": {
    "editor.background": "#130D25",
    "editor.foreground": "#EEE2FA",
    "editor.lineHighlightBackground": "#382454",
    "editorLineNumber.foreground": "#B0A3C4",
    "editorLineNumber.activeForeground": "#B5ABF5",
    "editorGutter.background": "#130D25",
    "sideBar.background": "#25163D",
    "foreground": "#EEE2FA",
    "descriptionForeground": "#B0A3C4",
    "list.highlightForeground": "#B5ABF5",
    "dropdown.background": "#382454",
    "list.hoverBackground": "#5A4379",
    "panel.border": "#5A4379",
    "focusBorder": "#B5ABF5",
    "editorGroupHeader.tabsBackground": "#25163D",
    "tab.activeBackground": "#382454",
    "tab.inactiveBackground": "#130D25",
    "panel.background": "#25163D",
    "titleBar.activeBackground": "#25163D",
    "statusBar.background": "#25163D",
    "terminal.background": "#130D25",
    "terminal.foreground": "#EEE2FA",
    "terminal.ansiBlack": "#101015",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#EEE2FA",
    "activityBar.background": "#25163D",
    "sideBarTitle.foreground": "#EEE2FA",
    "editorCursor.foreground": "#EEE2FA",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B5ABF5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#EDA3D8"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B0A3C4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#94D6E4"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#A7BCF6"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#D8B3ED"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#B5ABF5"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#EEE2FA"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#EEE2FA"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#EEE2FA"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#D8B3ED",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#B0A3C4"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#B5ABF5"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#EDA3D8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#94D6E4"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#EDA3D8"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#B5ABF5",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
