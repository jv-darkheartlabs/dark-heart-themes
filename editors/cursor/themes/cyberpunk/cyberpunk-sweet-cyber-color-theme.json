{
  "name": "Cyberpunk - Sweet Cyber \u2014 Original Palette",
  "type": "dark",
  "colors": {
    "editor.background": "#211329",
    "editor.foreground": "#F4E6E9",
    "editor.lineHighlightBackground": "#432B50",
    "editorLineNumber.foreground": "#BBA8C5",
    "editorLineNumber.activeForeground": "#EAB0D0",
    "editorGutter.background": "#211329",
    "sideBar.background": "#301D3B",
    "foreground": "#F4E6E9",
    "descriptionForeground": "#BBA8C5",
    "list.highlightForeground": "#EAB0D0",
    "dropdown.background": "#432B50",
    "list.hoverBackground": "#654875",
    "panel.border": "#654875",
    "focusBorder": "#EAB0D0",
    "editorGroupHeader.tabsBackground": "#301D3B",
    "tab.activeBackground": "#432B50",
    "tab.inactiveBackground": "#211329",
    "panel.background": "#301D3B",
    "titleBar.activeBackground": "#301D3B",
    "statusBar.background": "#301D3B",
    "terminal.background": "#211329",
    "terminal.foreground": "#F4E6E9",
    "terminal.ansiBlack": "#150C1B",
    "terminal.ansiRed": "#F08C9C",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#A4BCEB",
    "terminal.ansiMagenta": "#EAB0D0",
    "terminal.ansiCyan": "#A0D7DD",
    "terminal.ansiWhite": "#F4E6E9",
    "activityBar.background": "#301D3B",
    "sideBarTitle.foreground": "#F4E6E9",
    "editorCursor.foreground": "#F4E6E9",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#EAB0D0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#CEB8EE"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#BBA8C5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#F2DFC0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#F2DFC0"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#EAB0D0"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#EAB0D0"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#F4E6E9"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#F4E6E9"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#F4E6E9"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F2DFC0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#BBA8C5"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#EAB0D0"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#CEB8EE"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#F2DFC0"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#CEB8EE"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#EAB0D0",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
