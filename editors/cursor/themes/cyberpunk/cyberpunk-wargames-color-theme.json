{
  "name": "Cyberpunk - WarGames \u2014 WOPR",
  "type": "dark",
  "colors": {
    "editor.background": "#0A140E",
    "editor.foreground": "#D6E7C4",
    "editor.lineHighlightBackground": "#1C3424",
    "editorLineNumber.foreground": "#9BAC91",
    "editorLineNumber.activeForeground": "#A7D88E",
    "editorGutter.background": "#0A140E",
    "sideBar.background": "#12251A",
    "foreground": "#D6E7C4",
    "descriptionForeground": "#9BAC91",
    "list.highlightForeground": "#A7D88E",
    "dropdown.background": "#1C3424",
    "list.hoverBackground": "#3B563E",
    "panel.border": "#3B563E",
    "focusBorder": "#A7D88E",
    "editorGroupHeader.tabsBackground": "#12251A",
    "tab.activeBackground": "#1C3424",
    "tab.inactiveBackground": "#0A140E",
    "panel.background": "#12251A",
    "titleBar.activeBackground": "#12251A",
    "statusBar.background": "#12251A",
    "terminal.background": "#0A140E",
    "terminal.foreground": "#D6E7C4",
    "terminal.ansiBlack": "#101015",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#D6E7C4",
    "activityBar.background": "#12251A",
    "sideBarTitle.foreground": "#D6E7C4",
    "editorCursor.foreground": "#D6E7C4",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#A7D88E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#E0C58A"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9BAC91",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#B5DFB1"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#B5DFB1"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E0C58A"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#A7D88E"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#D6E7C4"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#D6E7C4"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#D6E7C4"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#B5DFB1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#9BAC91"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#A7D88E"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E0C58A"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#B5DFB1"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#E0C58A"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#A7D88E",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
