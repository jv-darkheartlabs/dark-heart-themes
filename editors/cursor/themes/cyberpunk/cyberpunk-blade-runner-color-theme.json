{
  "name": "Cyberpunk - Blade Runner (1982) \u2014 Los Angeles",
  "type": "dark",
  "colors": {
    "editor.background": "#08141B",
    "editor.foreground": "#DBE8EC",
    "editor.lineHighlightBackground": "#ffffff0a",
    "editorLineNumber.foreground": "#8DADB9",
    "editorLineNumber.activeForeground": "#72C9DB",
    "editorGutter.background": "#08141B",
    "sideBar.background": "#0D2029",
    "foreground": "#DBE8EC",
    "descriptionForeground": "#8DADB9",
    "list.highlightForeground": "#72C9DB",
    "dropdown.background": "#0D2029",
    "list.hoverBackground": "#ffffff18",
    "panel.border": "#47616D",
    "focusBorder": "#72C9DB",
    "editorGroupHeader.tabsBackground": "#08141B",
    "tab.activeBackground": "#0D2029",
    "tab.inactiveBackground": "#08141B",
    "panel.background": "#0D2029",
    "titleBar.activeBackground": "#0D2029",
    "statusBar.background": "#0D2029",
    "terminal.background": "#08141B",
    "terminal.foreground": "#DBE8EC",
    "terminal.ansiBlack": "#08141B",
    "terminal.ansiRed": "#F08186",
    "terminal.ansiGreen": "#99CC99",
    "terminal.ansiYellow": "#E7CD87",
    "terminal.ansiBlue": "#8DBAE8",
    "terminal.ansiMagenta": "#D8A0DE",
    "terminal.ansiCyan": "#88D1DB",
    "terminal.ansiWhite": "#DBE8EC",
    "activityBar.background": "#0D2029",
    "sideBarTitle.foreground": "#DBE8EC",
    "editorCursor.foreground": "#DBE8EC",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#72C9DB",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#E8BA79"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8DADB9",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#D99AAF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#D99AAF"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E8BA79"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#E8BA79"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#DBE8EC"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#DBE8EC"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#DBE8EC"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#72C9DB",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#8DADB9"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#72C9DB"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#D99AAF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#D99AAF"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#E8BA79"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#72C9DB",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
