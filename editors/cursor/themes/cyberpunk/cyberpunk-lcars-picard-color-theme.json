{
  "name": "Cyberpunk - Star Trek: Picard \u2014 Modern LCARS",
  "type": "dark",
  "colors": {
    "editor.background": "#080C13",
    "editor.foreground": "#DEEBF6",
    "editor.lineHighlightBackground": "#1C2B40",
    "editorLineNumber.foreground": "#9EAFC1",
    "editorLineNumber.activeForeground": "#8DC8F4",
    "editorGutter.background": "#080C13",
    "sideBar.background": "#101B2A",
    "foreground": "#DEEBF6",
    "descriptionForeground": "#9EAFC1",
    "list.highlightForeground": "#8DC8F4",
    "dropdown.background": "#1C2B40",
    "list.hoverBackground": "#354D68",
    "panel.border": "#354D68",
    "focusBorder": "#8DC8F4",
    "editorGroupHeader.tabsBackground": "#101B2A",
    "tab.activeBackground": "#1C2B40",
    "tab.inactiveBackground": "#080C13",
    "panel.background": "#101B2A",
    "titleBar.activeBackground": "#101B2A",
    "statusBar.background": "#101B2A",
    "terminal.background": "#080C13",
    "terminal.foreground": "#DEEBF6",
    "terminal.ansiBlack": "#101015",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#DEEBF6",
    "activityBar.background": "#101B2A",
    "sideBarTitle.foreground": "#DEEBF6",
    "editorCursor.foreground": "#DEEBF6",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8DC8F4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#C3B9EC"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9EAFC1",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#AAB9EE"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#AAB9EE"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#C3B9EC"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#8DC8F4"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#DEEBF6"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#DEEBF6"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#DEEBF6"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#AAB9EE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#9EAFC1"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#8DC8F4"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C3B9EC"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#AAB9EE"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#C3B9EC"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#8DC8F4",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
