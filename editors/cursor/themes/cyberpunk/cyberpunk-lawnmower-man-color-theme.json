{
  "name": "Cyberpunk - The Lawnmower Man \u2014 VR",
  "type": "dark",
  "colors": {
    "editor.background": "#130D25",
    "editor.foreground": "#ECE5FA",
    "editor.lineHighlightBackground": "#352451",
    "editorLineNumber.foreground": "#AFA4C7",
    "editorLineNumber.activeForeground": "#D4A0F4",
    "editorGutter.background": "#130D25",
    "sideBar.background": "#24153E",
    "foreground": "#ECE5FA",
    "descriptionForeground": "#AFA4C7",
    "list.highlightForeground": "#D4A0F4",
    "dropdown.background": "#352451",
    "list.hoverBackground": "#594378",
    "panel.border": "#594378",
    "focusBorder": "#D4A0F4",
    "editorGroupHeader.tabsBackground": "#24153E",
    "tab.activeBackground": "#352451",
    "tab.inactiveBackground": "#130D25",
    "panel.background": "#24153E",
    "titleBar.activeBackground": "#24153E",
    "statusBar.background": "#24153E",
    "terminal.background": "#130D25",
    "terminal.foreground": "#ECE5FA",
    "terminal.ansiBlack": "#101015",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#ECE5FA",
    "activityBar.background": "#24153E",
    "sideBarTitle.foreground": "#ECE5FA",
    "editorCursor.foreground": "#ECE5FA",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D4A0F4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#89E1DE"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#AFA4C7",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#F3A5D7"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#A9C0FF"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E8D77E"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#ACDF95"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ECE5FA"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#ECE5FA"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#ECE5FA"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#E8D77E",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#AFA4C7"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#A9C0FF"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#89E1DE"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#F3A5D7"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#89E1DE"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#D4A0F4",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
