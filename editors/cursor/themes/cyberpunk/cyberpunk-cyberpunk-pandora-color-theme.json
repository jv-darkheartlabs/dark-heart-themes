{
  "name": "Cyberpunk - Avatar: Pandora \u2014 Bioluminescent Forest",
  "type": "dark",
  "colors": {
    "editor.background": "#071B20",
    "editor.foreground": "#D6F1EA",
    "editor.lineHighlightBackground": "#16434A",
    "editorLineNumber.foreground": "#95B6B6",
    "editorLineNumber.activeForeground": "#83DEE3",
    "editorGutter.background": "#071B20",
    "sideBar.background": "#0D2D32",
    "foreground": "#D6F1EA",
    "descriptionForeground": "#95B6B6",
    "list.highlightForeground": "#83DEE3",
    "dropdown.background": "#16434A",
    "list.hoverBackground": "#2B646B",
    "panel.border": "#2B646B",
    "focusBorder": "#83DEE3",
    "editorGroupHeader.tabsBackground": "#0D2D32",
    "tab.activeBackground": "#16434A",
    "tab.inactiveBackground": "#071B20",
    "panel.background": "#0D2D32",
    "titleBar.activeBackground": "#0D2D32",
    "statusBar.background": "#0D2D32",
    "terminal.background": "#071B20",
    "terminal.foreground": "#D6F1EA",
    "terminal.ansiBlack": "#101015",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#D6F1EA",
    "activityBar.background": "#0D2D32",
    "sideBarTitle.foreground": "#D6F1EA",
    "editorCursor.foreground": "#D6F1EA",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#83DEE3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#8DD9BD"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#95B6B6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#9BBDF5"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#B9ADEE"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#A6D9E9"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#83DEE3"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#D6F1EA"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#D6F1EA"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#D6F1EA"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#B9ADEE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#95B6B6"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#83DEE3"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#8DD9BD"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#9BBDF5"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#8DD9BD"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#83DEE3",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
