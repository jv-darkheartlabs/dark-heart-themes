{
  "name": "Cyberpunk - TRON: Legacy \u2014 Rinzler",
  "type": "dark",
  "colors": {
    "editor.background": "#0C0C0F",
    "editor.foreground": "#E8E3DC",
    "editor.lineHighlightBackground": "#FF9B4B0D",
    "editorLineNumber.foreground": "#A3A09C",
    "editorLineNumber.activeForeground": "#FF9B4B",
    "editorGutter.background": "#0C0C0F",
    "sideBar.background": "#19191E",
    "foreground": "#E8E3DC",
    "descriptionForeground": "#A3A09C",
    "list.highlightForeground": "#FF9B4B",
    "dropdown.background": "#19191E",
    "list.hoverBackground": "#FF9B4B22",
    "panel.border": "#594032",
    "focusBorder": "#FF9B4B",
    "editorGroupHeader.tabsBackground": "#0C0C0F",
    "tab.activeBackground": "#FF9B4B18",
    "tab.inactiveBackground": "#0C0C0F",
    "panel.background": "#19191E",
    "titleBar.activeBackground": "#0C0C0F",
    "statusBar.background": "#0C0C0F",
    "terminal.background": "#0C0C0F",
    "terminal.foreground": "#E8E3DC",
    "terminal.ansiBlack": "#0C0C0F",
    "terminal.ansiRed": "#F48787",
    "terminal.ansiGreen": "#8CCB8C",
    "terminal.ansiYellow": "#EACB78",
    "terminal.ansiBlue": "#8BB5EF",
    "terminal.ansiMagenta": "#CEAAED",
    "terminal.ansiCyan": "#84D6DC",
    "terminal.ansiWhite": "#E8E3DC",
    "activityBar.background": "#19191E",
    "sideBarTitle.foreground": "#E8E3DC",
    "editorCursor.foreground": "#E8E3DC",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FF9B4B",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#F3B885"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A3A09C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#CCD1DA"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#FFB765"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FFB765"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#FFB765"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E8E3DC"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E8E3DC"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#E8E3DC"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#FF9B4B",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#A3A09C"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#FF9B4B"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F3B885"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#CCD1DA"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#F3B885"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#FF9B4B",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
