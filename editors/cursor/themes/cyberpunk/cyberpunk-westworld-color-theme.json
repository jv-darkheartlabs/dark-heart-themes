{
  "name": "Cyberpunk - Westworld \u2014 Western Park",
  "type": "dark",
  "colors": {
    "editor.background": "#1C1712",
    "editor.foreground": "#F1E6CF",
    "editor.lineHighlightBackground": "#352B20",
    "editorLineNumber.foreground": "#B8AA98",
    "editorLineNumber.activeForeground": "#E4A086",
    "editorGutter.background": "#1C1712",
    "sideBar.background": "#292118",
    "foreground": "#F1E6CF",
    "descriptionForeground": "#B8AA98",
    "list.highlightForeground": "#E4A086",
    "dropdown.background": "#352B20",
    "list.hoverBackground": "#584535",
    "panel.border": "#584535",
    "focusBorder": "#E4A086",
    "editorGroupHeader.tabsBackground": "#292118",
    "tab.activeBackground": "#352B20",
    "tab.inactiveBackground": "#1C1712",
    "panel.background": "#292118",
    "titleBar.activeBackground": "#292118",
    "statusBar.background": "#292118",
    "terminal.background": "#1C1712",
    "terminal.foreground": "#F1E6CF",
    "terminal.ansiBlack": "#17130F",
    "terminal.ansiRed": "#E89486",
    "terminal.ansiGreen": "#ADC495",
    "terminal.ansiYellow": "#E3C17F",
    "terminal.ansiBlue": "#9BBAD6",
    "terminal.ansiMagenta": "#C7A3C1",
    "terminal.ansiCyan": "#9BCAC2",
    "terminal.ansiWhite": "#F1E6CF",
    "activityBar.background": "#292118",
    "sideBarTitle.foreground": "#F1E6CF",
    "editorCursor.foreground": "#F1E6CF",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E4A086",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#D9C194"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B8AA98",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#F4DEB0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#F4DEB0"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E4A086"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#E4A086"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#F1E6CF"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#F1E6CF"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#F1E6CF"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F4DEB0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#B8AA98"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E4A086"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#D9C194"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#F4DEB0"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#D9C194"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#E4A086",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
