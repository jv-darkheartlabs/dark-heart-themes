{
  "name": "Cyberpunk - Hackers (1995) \u2014 The Gibson",
  "type": "dark",
  "colors": {
    "editor.background": "#0A1320",
    "editor.foreground": "#DCE8F2",
    "editor.lineHighlightBackground": "#1C3048",
    "editorLineNumber.foreground": "#93A8BA",
    "editorLineNumber.activeForeground": "#8FCBE8",
    "editorGutter.background": "#0A1320",
    "sideBar.background": "#122338",
    "foreground": "#DCE8F2",
    "descriptionForeground": "#93A8BA",
    "list.highlightForeground": "#8FCBE8",
    "dropdown.background": "#1C3048",
    "list.hoverBackground": "#354D66",
    "panel.border": "#354D66",
    "focusBorder": "#8FCBE8",
    "editorGroupHeader.tabsBackground": "#122338",
    "tab.activeBackground": "#1C3048",
    "tab.inactiveBackground": "#0A1320",
    "panel.background": "#122338",
    "titleBar.activeBackground": "#122338",
    "statusBar.background": "#122338",
    "terminal.background": "#0A1320",
    "terminal.foreground": "#DCE8F2",
    "terminal.ansiBlack": "#101219",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#DCE8F2",
    "activityBar.background": "#122338",
    "sideBarTitle.foreground": "#DCE8F2",
    "editorCursor.foreground": "#DCE8F2",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#8FCBE8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#E5BF79"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#93A8BA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#C7D6E2"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#C7D6E2"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E5BF79"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#8FCBE8"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#DCE8F2"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#DCE8F2"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#DCE8F2"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#C7D6E2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#93A8BA"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#8FCBE8"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#E5BF79"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#C7D6E2"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#E5BF79"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#8FCBE8",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
