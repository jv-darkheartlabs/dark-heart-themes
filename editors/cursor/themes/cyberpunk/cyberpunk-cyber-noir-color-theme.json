{
  "name": "Cyberpunk - Cyber Noir \u2014 Original Palette",
  "type": "dark",
  "colors": {
    "editor.background": "#101014",
    "editor.foreground": "#EFE8DC",
    "editor.lineHighlightBackground": "#2B222E",
    "editorLineNumber.foreground": "#A9A8B4",
    "editorLineNumber.activeForeground": "#F08087",
    "editorGutter.background": "#101014",
    "sideBar.background": "#1A1920",
    "foreground": "#EFE8DC",
    "descriptionForeground": "#A9A8B4",
    "list.highlightForeground": "#F08087",
    "dropdown.background": "#2B222E",
    "list.hoverBackground": "#52404E",
    "panel.border": "#52404E",
    "focusBorder": "#F08087",
    "editorGroupHeader.tabsBackground": "#1A1920",
    "tab.activeBackground": "#2B222E",
    "tab.inactiveBackground": "#101014",
    "panel.background": "#1A1920",
    "titleBar.activeBackground": "#1A1920",
    "statusBar.background": "#1A1920",
    "terminal.background": "#101014",
    "terminal.foreground": "#EFE8DC",
    "terminal.ansiBlack": "#08080A",
    "terminal.ansiRed": "#F08087",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#EFE8DC",
    "activityBar.background": "#1A1920",
    "sideBarTitle.foreground": "#EFE8DC",
    "editorCursor.foreground": "#EFE8DC",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F08087",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#C3C5CF"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A9A8B4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#E8D9BE"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#E8D9BE"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F08087"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#F08087"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#EFE8DC"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#EFE8DC"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#EFE8DC"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#E8D9BE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#A9A8B4"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F08087"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C3C5CF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#E8D9BE"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#C3C5CF"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#F08087",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
