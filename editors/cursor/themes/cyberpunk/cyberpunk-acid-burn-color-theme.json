{
  "name": "Cyberpunk - Hackers (1995) \u2014 Acid Burn",
  "type": "dark",
  "colors": {
    "editor.background": "#100D1C",
    "editor.foreground": "#ECE7FA",
    "editor.lineHighlightBackground": "#29203D",
    "editorLineNumber.foreground": "#AAA2BF",
    "editorLineNumber.activeForeground": "#79BBFF",
    "editorGutter.background": "#100D1C",
    "sideBar.background": "#1C1530",
    "foreground": "#ECE7FA",
    "descriptionForeground": "#AAA2BF",
    "list.highlightForeground": "#79BBFF",
    "dropdown.background": "#29203D",
    "list.hoverBackground": "#4D3E6B",
    "panel.border": "#4D3E6B",
    "focusBorder": "#79BBFF",
    "editorGroupHeader.tabsBackground": "#1C1530",
    "tab.activeBackground": "#29203D",
    "tab.inactiveBackground": "#100D1C",
    "panel.background": "#1C1530",
    "titleBar.activeBackground": "#1C1530",
    "statusBar.background": "#1C1530",
    "terminal.background": "#100D1C",
    "terminal.foreground": "#ECE7FA",
    "terminal.ansiBlack": "#101219",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#ECE7FA",
    "activityBar.background": "#1C1530",
    "sideBarTitle.foreground": "#ECE7FA",
    "editorCursor.foreground": "#ECE7FA",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#79BBFF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#F19AD6"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#AAA2BF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#D7C8FF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#D7C8FF"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F19AD6"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#79BBFF"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ECE7FA"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#ECE7FA"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#ECE7FA"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#D7C8FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#AAA2BF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#79BBFF"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#F19AD6"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#D7C8FF"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#F19AD6"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#79BBFF",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
