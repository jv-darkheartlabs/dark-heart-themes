{
  "name": "Cyberpunk - Star Trek: The Next Generation \u2014 Classic LCARS",
  "type": "dark",
  "colors": {
    "editor.background": "#08080B",
    "editor.foreground": "#F2DECE",
    "editor.lineHighlightBackground": "#292133",
    "editorLineNumber.foreground": "#B0A5B7",
    "editorLineNumber.activeForeground": "#F0BB75",
    "editorGutter.background": "#08080B",
    "sideBar.background": "#17121C",
    "foreground": "#F2DECE",
    "descriptionForeground": "#B0A5B7",
    "list.highlightForeground": "#F0BB75",
    "dropdown.background": "#292133",
    "list.hoverBackground": "#614D6D",
    "panel.border": "#614D6D",
    "focusBorder": "#F0BB75",
    "editorGroupHeader.tabsBackground": "#17121C",
    "tab.activeBackground": "#292133",
    "tab.inactiveBackground": "#08080B",
    "panel.background": "#17121C",
    "titleBar.activeBackground": "#17121C",
    "statusBar.background": "#17121C",
    "terminal.background": "#08080B",
    "terminal.foreground": "#F2DECE",
    "terminal.ansiBlack": "#101015",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A5D799",
    "terminal.ansiYellow": "#E8D18B",
    "terminal.ansiBlue": "#8FBDEB",
    "terminal.ansiMagenta": "#DA9AD4",
    "terminal.ansiCyan": "#8CD9DD",
    "terminal.ansiWhite": "#F2DECE",
    "activityBar.background": "#17121C",
    "sideBarTitle.foreground": "#F2DECE",
    "editorCursor.foreground": "#F2DECE",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F0BB75",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#EFB49C"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B0A5B7",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#C2ACE8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#C2ACE8"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#EFB49C"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#F0BB75"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#F2DECE"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#F2DECE"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#F2DECE"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#C2ACE8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#B0A5B7"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F0BB75"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#EFB49C"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#C2ACE8"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#EFB49C"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#F0BB75",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
