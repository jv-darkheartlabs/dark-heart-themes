{
  "name": "Cyberpunk - Ghost in the Shell (1995) \u2014 Rain City",
  "type": "dark",
  "colors": {
    "editor.background": "#091511",
    "editor.foreground": "#D6E6D8",
    "editor.lineHighlightBackground": "#ffffff0a",
    "editorLineNumber.foreground": "#91ACA0",
    "editorLineNumber.activeForeground": "#83CBB8",
    "editorGutter.background": "#091511",
    "sideBar.background": "#10231D",
    "foreground": "#D6E6D8",
    "descriptionForeground": "#91ACA0",
    "list.highlightForeground": "#83CBB8",
    "dropdown.background": "#10231D",
    "list.hoverBackground": "#ffffff18",
    "panel.border": "#426459",
    "focusBorder": "#83CBB8",
    "editorGroupHeader.tabsBackground": "#091511",
    "tab.activeBackground": "#10231D",
    "tab.inactiveBackground": "#091511",
    "panel.background": "#10231D",
    "titleBar.activeBackground": "#091511",
    "statusBar.background": "#091511",
    "terminal.background": "#091511",
    "terminal.foreground": "#D6E6D8",
    "terminal.ansiBlack": "#091511",
    "terminal.ansiRed": "#F38D91",
    "terminal.ansiGreen": "#9BCD95",
    "terminal.ansiYellow": "#E6CD86",
    "terminal.ansiBlue": "#86B6EC",
    "terminal.ansiMagenta": "#D6A0DF",
    "terminal.ansiCyan": "#85D8D8",
    "terminal.ansiWhite": "#D6E6D8",
    "activityBar.background": "#10231D",
    "sideBarTitle.foreground": "#D6E6D8",
    "editorCursor.foreground": "#D6E6D8",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#83CBB8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#B1D69A"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#91ACA0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#E7BD7B"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#A1D4C5"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E7BD7B"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#83CBB8"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#D6E6D8"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#D6E6D8"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#D6E6D8"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#83CBB8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#91ACA0"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#83CBB8"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#D6E6D8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#83CBB8"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#B1D69A"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#83CBB8",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
