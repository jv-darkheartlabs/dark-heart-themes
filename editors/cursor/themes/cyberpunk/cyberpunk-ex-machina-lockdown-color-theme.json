{
  "name": "Cyberpunk - Ex Machina \u2014 Lockdown",
  "type": "dark",
  "colors": {
    "editor.background": "#160F12",
    "editor.foreground": "#F2E3E3",
    "editor.lineHighlightBackground": "#3B1A23",
    "editorLineNumber.foreground": "#BBA3AB",
    "editorLineNumber.activeForeground": "#F28A8D",
    "editorGutter.background": "#160F12",
    "sideBar.background": "#251419",
    "foreground": "#F2E3E3",
    "descriptionForeground": "#BBA3AB",
    "list.highlightForeground": "#F28A8D",
    "dropdown.background": "#3B1A23",
    "list.hoverBackground": "#65323C",
    "panel.border": "#65323C",
    "focusBorder": "#F28A8D",
    "editorGroupHeader.tabsBackground": "#251419",
    "tab.activeBackground": "#3B1A23",
    "tab.inactiveBackground": "#160F12",
    "panel.background": "#251419",
    "titleBar.activeBackground": "#251419",
    "statusBar.background": "#251419",
    "terminal.background": "#160F12",
    "terminal.foreground": "#F2E3E3",
    "terminal.ansiBlack": "#100C0E",
    "terminal.ansiRed": "#F28A8D",
    "terminal.ansiGreen": "#A7CAA9",
    "terminal.ansiYellow": "#E4C18B",
    "terminal.ansiBlue": "#A0BCDE",
    "terminal.ansiMagenta": "#D0A3CE",
    "terminal.ansiCyan": "#9CCACD",
    "terminal.ansiWhite": "#F2E3E3",
    "activityBar.background": "#251419",
    "sideBarTitle.foreground": "#F2E3E3",
    "editorCursor.foreground": "#F2E3E3",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#F28A8D",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#EFB2AE"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#BBA3AB",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#FFE0D8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#FFE0D8"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F28A8D"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#F28A8D"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#F2E3E3"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#F2E3E3"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#F2E3E3"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#FFE0D8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#BBA3AB"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F28A8D"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#EFB2AE"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#FFE0D8"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#EFB2AE"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#F28A8D",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
