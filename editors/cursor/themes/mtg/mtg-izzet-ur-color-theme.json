{
  "name": "Mtg - Izzet League",
  "type": "dark",
  "colors": {
    "editor.background": "#101A2A",
    "editor.foreground": "#E5E4EB",
    "editor.lineHighlightBackground": "#ffffff0a",
    "editorLineNumber.foreground": "#99A7BB",
    "editorLineNumber.activeForeground": "#6EB8F4",
    "editorGutter.background": "#101A2A",
    "sideBar.background": "#1A2940",
    "foreground": "#E5E4EB",
    "descriptionForeground": "#99A7BB",
    "list.highlightForeground": "#6EB8F4",
    "dropdown.background": "#ffffff10",
    "list.hoverBackground": "#ffffff18",
    "panel.border": "#1A2940",
    "focusBorder": "#6EB8F4",
    "editorGroupHeader.tabsBackground": "#101A2A",
    "tab.activeBackground": "#1A2940",
    "tab.inactiveBackground": "#101A2A",
    "panel.background": "#1A2940",
    "titleBar.activeBackground": "#101A2A",
    "statusBar.background": "#1A2940",
    "terminal.background": "#101A2A",
    "terminal.foreground": "#E5E4EB",
    "terminal.ansiBlack": "#101A2A",
    "terminal.ansiRed": "#F0847A",
    "terminal.ansiGreen": "#A2CA8F",
    "terminal.ansiYellow": "#E4CE91",
    "terminal.ansiBlue": "#85B8E6",
    "terminal.ansiMagenta": "#C0A8CE",
    "terminal.ansiCyan": "#93CDD0",
    "terminal.ansiWhite": "#E5E4EB",
    "activityBar.background": "#1A2940",
    "sideBarTitle.foreground": "#E5E4EB",
    "editorCursor.foreground": "#E5E4EB",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6EB8F4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#EE8A89"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#99A7BB",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#B7DFFD"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#EE8A89"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#F5A5A1"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#F5A5A1"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E5E4EB"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E5E4EB"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#E5E4EB"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#F5A5A1",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#99A7BB"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#6EB8F4"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#EE8A89"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#B7DFFD"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#EE8A89"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#6EB8F4",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
