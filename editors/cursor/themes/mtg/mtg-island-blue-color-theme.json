{
  "name": "Mtg - Island Blue",
  "type": "dark",
  "colors": {
    "editor.background": "#0B192A",
    "editor.foreground": "#D9E8F5",
    "editor.lineHighlightBackground": "#ffffff0a",
    "editorLineNumber.foreground": "#8CA8BF",
    "editorLineNumber.activeForeground": "#69AEFF",
    "editorGutter.background": "#0B192A",
    "sideBar.background": "#10263E",
    "foreground": "#D9E8F5",
    "descriptionForeground": "#8CA8BF",
    "list.highlightForeground": "#69AEFF",
    "dropdown.background": "#ffffff10",
    "list.hoverBackground": "#ffffff18",
    "panel.border": "#10263E",
    "focusBorder": "#69AEFF",
    "editorGroupHeader.tabsBackground": "#0B192A",
    "tab.activeBackground": "#10263E",
    "tab.inactiveBackground": "#0B192A",
    "panel.background": "#10263E",
    "titleBar.activeBackground": "#0B192A",
    "statusBar.background": "#10263E",
    "terminal.background": "#0B192A",
    "terminal.foreground": "#D9E8F5",
    "terminal.ansiBlack": "#0B192A",
    "terminal.ansiRed": "#F0847A",
    "terminal.ansiGreen": "#A2CA8F",
    "terminal.ansiYellow": "#E4CE91",
    "terminal.ansiBlue": "#85B8E6",
    "terminal.ansiMagenta": "#C0A8CE",
    "terminal.ansiCyan": "#93CDD0",
    "terminal.ansiWhite": "#D9E8F5",
    "activityBar.background": "#10263E",
    "sideBarTitle.foreground": "#D9E8F5",
    "editorCursor.foreground": "#D9E8F5",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#69AEFF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#92C6EC"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8CA8BF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#C2E4FF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#92C6EC"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#449DE8"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#449DE8"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#D9E8F5"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#D9E8F5"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#D9E8F5"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#449DE8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#8CA8BF"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#69AEFF"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#92C6EC"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#C2E4FF"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#92C6EC"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#69AEFF",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
