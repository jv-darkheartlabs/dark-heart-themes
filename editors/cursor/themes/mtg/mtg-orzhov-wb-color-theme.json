{
  "name": "Mtg - Orzhov Syndicate",
  "type": "dark",
  "colors": {
    "editor.background": "#151416",
    "editor.foreground": "#EEE9DB",
    "editor.lineHighlightBackground": "#ffffff0a",
    "editorLineNumber.foreground": "#A9A398",
    "editorLineNumber.activeForeground": "#DFC885",
    "editorGutter.background": "#151416",
    "sideBar.background": "#272329",
    "foreground": "#EEE9DB",
    "descriptionForeground": "#A9A398",
    "list.highlightForeground": "#DFC885",
    "dropdown.background": "#ffffff10",
    "list.hoverBackground": "#ffffff18",
    "panel.border": "#272329",
    "focusBorder": "#DFC885",
    "editorGroupHeader.tabsBackground": "#151416",
    "tab.activeBackground": "#272329",
    "tab.inactiveBackground": "#151416",
    "panel.background": "#272329",
    "titleBar.activeBackground": "#151416",
    "statusBar.background": "#272329",
    "terminal.background": "#151416",
    "terminal.foreground": "#EEE9DB",
    "terminal.ansiBlack": "#151416",
    "terminal.ansiRed": "#F0847A",
    "terminal.ansiGreen": "#A2CA8F",
    "terminal.ansiYellow": "#E4CE91",
    "terminal.ansiBlue": "#85B8E6",
    "terminal.ansiMagenta": "#C0A8CE",
    "terminal.ansiCyan": "#93CDD0",
    "terminal.ansiWhite": "#EEE9DB",
    "activityBar.background": "#272329",
    "sideBarTitle.foreground": "#EEE9DB",
    "editorCursor.foreground": "#EEE9DB",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#DFC885",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#BEB9C0"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A9A398",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#FFF0C8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#BEB9C0"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#C6B899"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#C6B899"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#EEE9DB"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#EEE9DB"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#EEE9DB"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#C6B899",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#A9A398"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#DFC885"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#BEB9C0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#FFF0C8"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#BEB9C0"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#DFC885",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
