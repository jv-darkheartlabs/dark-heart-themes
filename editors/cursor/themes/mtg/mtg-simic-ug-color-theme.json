{
  "name": "Mtg - Simic Combine",
  "type": "dark",
  "colors": {
    "editor.background": "#0D211F",
    "editor.foreground": "#DCECE4",
    "editor.lineHighlightBackground": "#ffffff0a",
    "editorLineNumber.foreground": "#8EADA6",
    "editorLineNumber.activeForeground": "#70B9E8",
    "editorGutter.background": "#0D211F",
    "sideBar.background": "#173532",
    "foreground": "#DCECE4",
    "descriptionForeground": "#8EADA6",
    "list.highlightForeground": "#70B9E8",
    "dropdown.background": "#ffffff10",
    "list.hoverBackground": "#ffffff18",
    "panel.border": "#173532",
    "focusBorder": "#70B9E8",
    "editorGroupHeader.tabsBackground": "#0D211F",
    "tab.activeBackground": "#173532",
    "tab.inactiveBackground": "#0D211F",
    "panel.background": "#173532",
    "titleBar.activeBackground": "#0D211F",
    "statusBar.background": "#173532",
    "terminal.background": "#0D211F",
    "terminal.foreground": "#DCECE4",
    "terminal.ansiBlack": "#0D211F",
    "terminal.ansiRed": "#F0847A",
    "terminal.ansiGreen": "#A2CA8F",
    "terminal.ansiYellow": "#E4CE91",
    "terminal.ansiBlue": "#85B8E6",
    "terminal.ansiMagenta": "#C0A8CE",
    "terminal.ansiCyan": "#93CDD0",
    "terminal.ansiWhite": "#DCECE4",
    "activityBar.background": "#173532",
    "sideBarTitle.foreground": "#DCECE4",
    "editorCursor.foreground": "#DCECE4",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#70B9E8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#87C995"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8EADA6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#C0E4D2"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#87C995"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#9EDBBA"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#9EDBBA"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#DCECE4"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#DCECE4"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#DCECE4"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#9EDBBA",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#8EADA6"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#70B9E8"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#87C995"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#C0E4D2"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#87C995"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#70B9E8",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
