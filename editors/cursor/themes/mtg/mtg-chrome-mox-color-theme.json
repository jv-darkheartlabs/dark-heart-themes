{
  "name": "Mtg - Chrome Mox",
  "type": "dark",
  "colors": {
    "editor.background": "#15181C",
    "editor.foreground": "#E5E8EB",
    "editor.lineHighlightBackground": "#ffffff0a",
    "editorLineNumber.foreground": "#9EA7B0",
    "editorLineNumber.activeForeground": "#CAD3DC",
    "editorGutter.background": "#15181C",
    "sideBar.background": "#242A31",
    "foreground": "#E5E8EB",
    "descriptionForeground": "#9EA7B0",
    "list.highlightForeground": "#CAD3DC",
    "dropdown.background": "#ffffff10",
    "list.hoverBackground": "#ffffff18",
    "panel.border": "#242A31",
    "focusBorder": "#CAD3DC",
    "editorGroupHeader.tabsBackground": "#15181C",
    "tab.activeBackground": "#242A31",
    "tab.inactiveBackground": "#15181C",
    "panel.background": "#242A31",
    "titleBar.activeBackground": "#15181C",
    "statusBar.background": "#242A31",
    "terminal.background": "#15181C",
    "terminal.foreground": "#E5E8EB",
    "terminal.ansiBlack": "#15181C",
    "terminal.ansiRed": "#F0847A",
    "terminal.ansiGreen": "#A2CA8F",
    "terminal.ansiYellow": "#E4CE91",
    "terminal.ansiBlue": "#85B8E6",
    "terminal.ansiMagenta": "#C0A8CE",
    "terminal.ansiCyan": "#93CDD0",
    "terminal.ansiWhite": "#E5E8EB",
    "activityBar.background": "#242A31",
    "sideBarTitle.foreground": "#E5E8EB",
    "editorCursor.foreground": "#E5E8EB",
    "selection.background": "#264f78"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#CAD3DC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#9FC99C"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9EA7B0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#F1E7CE"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#89B9E4"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E8A08F"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#C3BACF"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E5E8EB"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#E5E8EB"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#E5E8EB"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#DEC995",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#9EA7B0"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#CAD3DC"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#B0BBC4"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.class"
      ],
      "settings": {
        "foreground": "#F1E7CE"
      }
    },
    {
      "scope": [
        "string.other.embedded",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#B0BBC4"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#CAD3DC",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold",
        "strong"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ]
}
