{
  "name": "TRON: Legacy — End of Line Club",
  "author": "Cyberpunk Collection",
  "themes": [
    {
      "name": "TRON: Legacy — End of Line Club",
      "appearance": "dark",
      "style": {
        "background": "#101019",
        "foreground": "#F4EFFA",
        "text": "#F4EFFA",
        "text.accent": "#EAE3FF",
        "text.muted": "#A49DB5",
        "editor.background": "#101019",
        "editor.foreground": "#F4EFFA",
        "editor.active_line.background": "#EAE3FF0D",
        "editor.line_number": "#A49DB5",
        "editor.active_line_number": "#EAE3FF",
        "editor.gutter.background": "#101019",
        "surface.background": "#1F1B2B",
        "element.background": "#1F1B2B",
        "element.hover": "#EAE3FF22",
        "border": "#574762",
        "border.focused": "#EAE3FF",
        "tab_bar.background": "#101019",
        "tab.active_background": "#EAE3FF18",
        "tab.inactive_background": "#101019",
        "panel.background": "#1F1B2B",
        "title_bar.background": "#101019",
        "status_bar.background": "#101019",
        "terminal.background": "#101019",
        "terminal.foreground": "#F4EFFA",
        "terminal.ansi.black": "#101019",
        "terminal.ansi.red": "#F48787",
        "terminal.ansi.green": "#8CCB8C",
        "terminal.ansi.yellow": "#EACB78",
        "terminal.ansi.blue": "#8BB5EF",
        "terminal.ansi.magenta": "#CEAAED",
        "terminal.ansi.cyan": "#84D6DC",
        "terminal.ansi.white": "#F4EFFA",
        "syntax": {
          "keyword": {
            "color": "#EAE3FF",
            "font_weight": 600
          },
          "string": {
            "color": "#C8A5F5"
          },
