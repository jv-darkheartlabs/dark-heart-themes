          "number": {
            "color": "#9EDDEA"
          },
          "boolean": {
            "color": "#9EDDEA"
          },
          "operator": {
            "color": "#F4EFFA"
          },
          "variable": {
            "color": "#F4EFFA"
          },
          "property": {
            "color": "#F4EFFA"
          },
          "constant": {
            "color": "#EAE3FF",
            "font_weight": 600
          },
          "punctuation": {
            "color": "#A49DB5"
          },
          "tag": {
            "color": "#EAE3FF"
          },
          "attribute": {
            "color": "#C8A5F5"
          },
          "constructor": {
            "color": "#F9F5FF"
          },
          "embedded": {
            "color": "#C8A5F5"
