          "boolean": {
            "color": "#900050"
          },
          "operator": {
            "color": "#e8e0ec"
          },
          "variable": {
            "color": "#e8e0ec"
          },
          "property": {
            "color": "#e0c0e0"
          },
          "constant": {
            "color": "#800020",
            "font_weight": 600
