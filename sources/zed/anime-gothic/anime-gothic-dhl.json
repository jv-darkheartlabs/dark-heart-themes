        "editor.active_line_number": "#f0b060",
        "editor.gutter.background": "#100020",
        "surface.background": "#200040",
        "element.background": "#300050",
        "element.hover": "#400070",
        "border": "#900050",
        "border.focused": "#a00060",
        "tab_bar.background": "#100020",
        "tab.active_background": "#200040",
        "tab.inactive_background": "#100020",
        "panel.background": "#200040",
        "title_bar.background": "#100020",
        "status_bar.background": "#100020",
        "terminal.background": "#000020",
        "terminal.foreground": "#e8e0ec",
        "terminal.ansi.black": "#100020",
        "terminal.ansi.red": "#800020",
        "terminal.ansi.green": "#c04080",
        "terminal.ansi.yellow": "#f0b060",
        "terminal.ansi.blue": "#400070",
        "terminal.ansi.magenta": "#a00060",
        "terminal.ansi.cyan": "#e0c0e0",
        "terminal.ansi.white": "#e8e0ec",
