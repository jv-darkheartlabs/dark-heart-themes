{
  "name": "Anime Gothic Dark Heart Labs",
  "author": "Dark Heart Labs",
  "themes": [
    {
      "name": "Anime Gothic Dark Heart Labs",
      "appearance": "dark",
      "style": {
        "background": "#100020",
        "foreground": "#e8e0ec",
