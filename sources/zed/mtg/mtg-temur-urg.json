        "tab_bar.background": "#142221",
        "tab.active_background": "#253633",
        "tab.inactive_background": "#142221",
        "panel.background": "#253633",
        "title_bar.background": "#142221",
        "status_bar.background": "#253633",
        "terminal.background": "#142221",
        "terminal.foreground": "#E4E9DB",
        "terminal.ansi.black": "#142221",
        "terminal.ansi.red": "#F0847A",
        "terminal.ansi.green": "#A2CA8F",
        "terminal.ansi.yellow": "#E4CE91",
        "terminal.ansi.blue": "#85B8E6",
        "terminal.ansi.magenta": "#C0A8CE",
        "terminal.ansi.cyan": "#93CDD0",
        "terminal.ansi.white": "#E4E9DB",
