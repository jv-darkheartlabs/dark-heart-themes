{
  "name": "MTG Temur Frontier",
  "author": "Jen the Dev MTG Collection",
  "themes": [
    {
      "name": "MTG Temur Frontier",
      "appearance": "dark",
      "style": {
        "background": "#142221",
        "foreground": "#E4E9DB",
        "text": "#E4E9DB",
        "text.accent": "#7CB8E4",
        "text.muted": "#9AADA5",
        "editor.background": "#142221",
        "editor.foreground": "#E4E9DB",
        "editor.active_line.background": "#ffffff0a",
        "editor.line_number": "#9AADA5",
        "editor.active_line_number": "#7CB8E4",
        "editor.gutter.background": "#142221",
        "surface.background": "#253633",
        "element.background": "#ffffff10",
        "element.hover": "#ffffff18",
        "border": "#253633",
