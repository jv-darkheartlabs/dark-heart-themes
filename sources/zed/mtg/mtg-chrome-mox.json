        "tab_bar.background": "#15181C",
        "tab.active_background": "#242A31",
        "tab.inactive_background": "#15181C",
        "panel.background": "#242A31",
        "title_bar.background": "#15181C",
        "status_bar.background": "#242A31",
        "terminal.background": "#15181C",
        "terminal.foreground": "#E5E8EB",
        "terminal.ansi.black": "#15181C",
        "terminal.ansi.red": "#F0847A",
        "terminal.ansi.green": "#A2CA8F",
        "terminal.ansi.yellow": "#E4CE91",
        "terminal.ansi.blue": "#85B8E6",
        "terminal.ansi.magenta": "#C0A8CE",
        "terminal.ansi.cyan": "#93CDD0",
        "terminal.ansi.white": "#E5E8EB",
        "syntax": {
          "keyword": {
            "color": "#CAD3DC",
            "font_weight": 600
          },
          "string": {
