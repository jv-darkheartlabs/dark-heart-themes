{
  "name": "MTG Chrome Mox",
  "author": "Jen the Dev MTG Collection",
  "themes": [
    {
      "name": "MTG Chrome Mox",
      "appearance": "dark",
      "style": {
        "background": "#15181C",
        "foreground": "#E5E8EB",
        "text": "#E5E8EB",
        "text.accent": "#CAD3DC",
        "text.muted": "#9EA7B0",
        "editor.background": "#15181C",
        "editor.foreground": "#E5E8EB",
        "editor.active_line.background": "#ffffff0a",
        "editor.line_number": "#9EA7B0",
        "editor.active_line_number": "#CAD3DC",
        "editor.gutter.background": "#15181C",
        "surface.background": "#242A31",
        "element.background": "#ffffff10",
        "element.hover": "#ffffff18",
        "border": "#242A31",
