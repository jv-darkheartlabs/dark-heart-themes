          "variable": {
            "color": "#E5E8EB"
          },
          "property": {
            "color": "#E5E8EB"
          },
          "constant": {
            "color": "#DEC995",
            "font_weight": 600
          },
          "punctuation": {
            "color": "#9EA7B0"
          },
          "tag": {
            "color": "#CAD3DC"
