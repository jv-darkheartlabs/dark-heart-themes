{
  "name": "MTG Orzhov Syndicate",
  "author": "Jen the Dev MTG Collection",
  "themes": [
    {
      "name": "MTG Orzhov Syndicate",
      "appearance": "dark",
      "style": {
        "background": "#151416",
        "foreground": "#EEE9DB",
        "text": "#EEE9DB",
        "text.accent": "#DFC885",
        "text.muted": "#A9A398",
        "editor.background": "#151416",
        "editor.foreground": "#EEE9DB",
        "editor.active_line.background": "#ffffff0a",
        "editor.line_number": "#A9A398",
        "editor.active_line_number": "#DFC885",
        "editor.gutter.background": "#151416",
        "surface.background": "#272329",
        "element.background": "#ffffff10",
        "element.hover": "#ffffff18",
        "border": "#272329",
        "border.focused": "#DFC885",
        "tab_bar.background": "#151416",
        "tab.active_background": "#272329",
        "tab.inactive_background": "#151416",
        "panel.background": "#272329",
        "title_bar.background": "#151416",
        "status_bar.background": "#272329",
        "terminal.background": "#151416",
        "terminal.foreground": "#EEE9DB",
        "terminal.ansi.black": "#151416",
        "terminal.ansi.red": "#F0847A",
        "terminal.ansi.green": "#A2CA8F",
        "terminal.ansi.yellow": "#E4CE91",
        "terminal.ansi.blue": "#85B8E6",
        "terminal.ansi.magenta": "#C0A8CE",
        "terminal.ansi.cyan": "#93CDD0",
        "terminal.ansi.white": "#EEE9DB",
        "syntax": {
          "keyword": {
            "color": "#DFC885",
            "font_weight": 600
          },
          "string": {
            "color": "#BEB9C0"
