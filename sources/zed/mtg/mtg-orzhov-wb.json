          },
          "type": {
            "color": "#BEB9C0"
          },
          "number": {
            "color": "#C6B899"
          },
          "boolean": {
            "color": "#C6B899"
          },
          "operator": {
            "color": "#EEE9DB"
          },
          "variable": {
            "color": "#EEE9DB"
          },
          "property": {
            "color": "#EEE9DB"
          },
          "constant": {
            "color": "#C6B899",
            "font_weight": 600
          },
          "punctuation": {
            "color": "#A9A398"
          },
          "tag": {
            "color": "#DFC885"
          },
          "attribute": {
            "color": "#BEB9C0"
          },
          "constructor": {
            "color": "#FFF0C8"
          },
          "embedded": {
            "color": "#BEB9C0"
          },
          "emphasis": {
            "font_style": "italic"
          },
          "strong": {
            "font_weight": 700
          },
          "link": {
            "color": "#DFC885",
            "underline": true
          }
